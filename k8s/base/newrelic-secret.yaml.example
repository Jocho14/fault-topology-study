# New Relic license key, referenced by every service Deployment as:
#   secretKeyRef: { name: newrelic, key: license-key }
#
# Do NOT commit the real key. Two ways to create the Secret in the cluster:
#
# 1) Imperative (recommended — keeps the key out of git):
#      kubectl create secret generic newrelic \
#        --from-literal=license-key=YOUR_REAL_LICENSE_KEY
#
# 2) Declarative: copy this file to newrelic-secret.yaml (gitignored),
#    put the real key below, then `kubectl apply -f k8s/base/newrelic-secret.yaml`.
apiVersion: v1
kind: Secret
metadata:
  name: newrelic
type: Opaque
stringData:
  license-key: your-new-relic-license-key-here
